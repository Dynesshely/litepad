{
  "name": "临时草稿本 · 自动保存",
  "short_name": "草稿本",
  "description": "纯本地 localStorage 自动保存的临时文本编辑器，无需手动保存",
  "lang": "zh-CN",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f4f5",
